# Copy to .env / .env.local for local development.
# Never commit real secrets. On Vercel, set the same keys in Project → Environment Variables.

# Prisma schema datasource (local SQLite for CLI / seed only).
# Runtime app queries use Turso below via src/lib/db.ts — not this file URL.
DATABASE_URL="file:./dev.db"

# Session signing (required). Use a long random string in every environment.
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical site URL (sitemap, absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Turso (required for the running Next.js app)
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Vercel Blob (required for admin image uploads).
# Paste the real RW token from Vercel → Storage → Blob (starts with vercel_blob_rw_).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Seed safety (local disposable SQLite only — never production / never Turso):
# ALLOW_DB_SEED=1
